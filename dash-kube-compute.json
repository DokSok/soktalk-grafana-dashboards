{
  "id": null,
  "uid": "kube-compute-resources",
  "title": "Kubernetes / Compute Resources / Cluster",
  "tags": [
    "kubernetes",
    "nodes"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "CPU Cores (Total)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) / count(count by (instance) (node_cpu_seconds_total))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        }
      },
      "description": "Total CPU core usage rate across the cluster divided by total cores, giving an overall cluster CPU utilization percentage. From `node_cpu_seconds_total` (non-idle) and node count."
    },
    {
      "id": 2,
      "title": "Memory Usage",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "(1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "description": "Cluster-wide memory usage percentage, from `(1 - sum(MemAvailable) / sum(MemTotal)) * 100`. From node_exporter."
    },
    {
      "id": 3,
      "title": "CPU Usage by Namespace",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) by (namespace)",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "core"
        }
      },
      "description": "CPU consumption rate grouped by namespace, from `container_cpu_usage_seconds_total` by (namespace)."
    },
    {
      "id": 4,
      "title": "Memory Usage by Namespace",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container!=\"\"}) by (namespace)",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Per-namespace memory consumption (working set bytes) across all containers, from `container_memory_working_set_bytes` by (namespace). Use this to see which namespaces are using the most memory. **Note:** despite the panel title, this shows per-namespace bytes \u2014 not a percentage."
    },
    {
      "id": 5,
      "title": "Node CPU Usage",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "description": "Per-node CPU utilization (100 - idle%), from `node_cpu_seconds_total` by (instance)."
    }
  ],
  "schemaVersion": 42,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "refresh": "5s",
  "links": [],
  "editable": true,
  "graphTooltip": 1
}
