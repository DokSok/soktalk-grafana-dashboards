{
  "id": null,
  "uid": "velero-backups",
  "title": "Velero / Backup Status",
  "tags": [
    "velero",
    "backup",
    "disaster-recovery"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Last Backup Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "velero_backup_status{status=\"Completed\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "Completed",
                "result": {
                  "color": "green",
                  "text": "Healthy"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        }
      },
      "description": "Status of the most recent backup (Completed or other), from `velero_backup_status`. Non-Completed indicates a problem with the latest backup."
    },
    {
      "id": 2,
      "title": "Total Backups",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(velero_backup_status)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Total number of backup resources tracked by Velero, from `velero_backup_status`."
    },
    {
      "id": 3,
      "title": "Successful Backups",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(velero_backup_status{status=\"Completed\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Count of backups with Completed status, from `velero_backup_status{status=\"Completed\"}`. These completed without error."
    },
    {
      "id": 4,
      "title": "Failed Backups",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(velero_backup_status{status=\"Failed\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "Count of backups with Failed status, from `velero_backup_status{status=\"Failed\"}`. These need investigation."
    },
    {
      "id": 5,
      "title": "Backup Duration (last 24h)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "time(velero_backup_time_since_last_backup) - time(velero_backup_status{status=\"Completed\"})",
          "legendFormat": "{{backup}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "description": "Time elapsed since the last completed backup, from `time since last backup - current time`. Shows backup freshness over the last 24 hours."
    },
    {
      "id": 6,
      "title": "Backup Size by Backup",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "velero_backup_size_bytes",
          "legendFormat": "{{backup}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Size in bytes of each backup, from `velero_backup_size_bytes`. Shows storage consumption per backup."
    },
    {
      "id": 7,
      "title": "Backup Count by Status",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "count(velero_backup_status) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Number of backups grouped by status (Completed, Failed, etc.), from `velero_backup_status` by (status)."
    },
    {
      "id": 8,
      "title": "Backup Timeline (last 7 days)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(increase(velero_backup_count_total[1h]))",
          "legendFormat": "Backups created",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Hourly rate of backup creation events over the last 7 days, from `increase(velero_backup_count_total[1h])`. Shows backup schedule adherence."
    },
    {
      "id": 9,
      "title": "Backup Errors (last 24h)",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(increase(velero_backup_errors_total[1h]))",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Hourly rate of backup errors over the last 24 hours, from `increase(velero_backup_errors_total[1h])`. Non-zero indicates backup failures."
    },
    {
      "id": 10,
      "title": "Backup Storage Location",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "velero_backup_storage_location_status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Status of the backup storage location (available / unavailable), from `velero_backup_storage_location_status`."
    },
    {
      "id": 11,
      "title": "Velero Pod Status",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Running\", pod=~\"velero-.*\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Number of Velero pods in Running state, from `kube_pod_status_phase` filtered to velero pods."
    },
    {
      "id": 12,
      "title": "Restore Status",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "count(velero_restore_status) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Count of restore operations grouped by status, from `velero_restore_status` by (status). Shows restore success/failure breakdown."
    }
  ],
  "schemaVersion": 42,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "refresh": "5s",
  "links": [],
  "editable": true,
  "graphTooltip": 1
}
